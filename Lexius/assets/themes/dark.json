{
  "name": "Lexius Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#272626",
    "editor.foreground": "#ffffff",
    "editorCursor.foreground": "#7700ff",
    "editorLineNumber.foreground": "#4B526D",
    "editor.selectionBackground": "#7e56c280"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#546E7A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#FF9E64"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#F78C6C"
      }
    },
    {
      "scope": ["keyword", "storage"],
      "settings": {
        "foreground": "#D67EEE"
      }
    },
    {
      "scope": ["variable", "identifier"],
      "settings": {
        "foreground": "#ffffff"
      }
    }
  ]
}
