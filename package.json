{
  "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/master/src/schemas/json/package.json",
  "name": "lexius",
  "version": "3.6.5",
  "description": "A minimal, web-based code editor built for speed, clarity, and effortless development.",
  "keywords": [
    "editor",
    "website",
    "ai",
    "code",
    "web-app",
    "code-editor",
    "ai-code-editor",
    "lexius",
    "vscode",
    "visual",
    "studio",
    "code",
    "vs",
    "code",
    "javascript",
    "html",
    "hypertext",
    "markup",
    "language",
    "typescript",
    "electron",
    "browser-based"
  ],
  "homepage": "https://github.com/PFMCODES/Lexius#readme",
  "bugs": {
    "url": "https://github.com/PFMCODES/Lexius/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PFMCODES/Lexius.git"
  },
  "license": "MIT",
  "author": "PFMCODES",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "web": "node web.js",
    "build": "npx electron-builder"
  },
  "build": {
    "appId": "com.pfmcodes.lexius",
    "productName": "Lexius",
    "win": {
      "target": "nsis",
      "icon": "assets/images/lexius.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Lexius",
      "installerIcon": "assets/images/lexius.ico",
      "uninstallerIcon": "assets/images/lexius.ico",
      "installerHeader": "build/header.bmp",
      "installerSidebar": "build/sidebar.bmp"
    }
  },
  "devDependencies": {
    "electron-builder": "^26.4.0",
    "electron-reload": "^2.0.0-alpha.1",
    "electron": "^39.2.7"
  }
}
